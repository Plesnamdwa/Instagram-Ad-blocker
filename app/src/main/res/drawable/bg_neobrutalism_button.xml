<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state (flat or inset) -->
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neo_white" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/neo_black" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state with hard shadow -->
    <item>
        <layer-list>
            <item
                android:left="4dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neo_black" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neo_white" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/neo_black" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
